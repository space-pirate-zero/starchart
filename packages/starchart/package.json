{
  "name": "@spz/starchart",
  "version": "0.1.0",
  "description": "Every dependency. Code to cosmos. A graph that bridges your code to everything it touches in the real world.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "starchart": "dist/cli/bin.js",
    "sc": "dist/cli/bin.js",
    "starchart-mcp": "dist/mcp/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
